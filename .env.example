# -----------------------------------------------------------------------------
# ClearNotes Environment Variables
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# Application URL (used for OAuth redirects and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database connection string
# Examples:
#   Local:     postgresql://postgres:postgres@localhost:5432/clearnotes
#   Supabase:  postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Neon:      postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clearnotes

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_32_character_random_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini AI (Get key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Optional: override default model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------

# Google Analytics Measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Better Auth Infra Dash API Key (optional analytics dashboard)
# BETTER_AUTH_API_KEY=your-better-auth-dash-api-key
