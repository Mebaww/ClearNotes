generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WaitListStatus {
  PENDING
  INVITED
  JOINED
}
enum  NoteStatus {
  PENDING
  PROCESSING
  COMPLETED
}

model Waitlist {
  id        String         @id @default(cuid())
  email     String         @unique
  source    String?
  status    WaitListStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime       @default(now())

  @@index([email])
  @@index([status])
}

model Note {
  id         String     @id @default(cuid())
  title      String?
  sourceText String?    @db.Text
  generated  String?    @db.Text

  status     NoteStatus @default(PROCESSING)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
